#!/bin/sh
set -e
export GOWORK=off

toolchain=$(awk '$1 == "toolchain" { print $2 }' cmd/go-sdk/go.mod)
gofmt="$(GOTOOLCHAIN="${toolchain:-go$(cd cmd/go-sdk && go list -m -f '{{.GoVersion}}')}" go env GOROOT)/bin/gofmt"
unformatted=$(find . -name '*.go' ! -path '*/testdata/*' -exec "$gofmt" -l {} +)
if [ -n "$unformatted" ]; then
  echo "gofmt: unformatted files:" >&2
  echo "$unformatted" >&2
  exit 1
fi
for module in . cmd/go-sdk; do
  (
    cd "$module"
    go vet ./...
    go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.14.0 run ./...
    go run github.com/fe3dback/go-arch-lint@v1.18.0 check --project-path .
    go test -count=1 ./...
    go run golang.org/x/vuln/cmd/govulncheck@latest ./...
  )
done
